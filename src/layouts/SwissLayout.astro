---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  articleDate?: string;
  noindex?: boolean;
}

const {
  title = "Persio's Technical Journal & System Lab",
  description = "Notes from Persio’s work on software, AI-assisted workflows, infrastructure, and projects.",
  articleDate,
  noindex = false,
} = Astro.props;

// Social links. An entry with an empty url is not rendered.
const social = [
  { label: 'GitHub', url: 'https://github.com/iHateThisGameSo' },
  { label: 'X', url: 'https://x.com/PucciPersio' },
  { label: 'LinkedIn', url: 'https://www.linkedin.com/in/ppucci/' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://persio.fyi');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50' fill='%23002fa7'/></svg>" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" type="application/rss+xml" title="Persio’s Journal" href="/rss.xml" />

  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}

  <!-- Open Graph / Social -->
  <meta property="og:type" content={articleDate ? 'article' : 'website'} />
  {articleDate && <meta property="article:published_time" content={`${articleDate}T00:00:00Z`} />}
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
</head>
<body id="top" class="p-6 md:p-12 max-w-7xl mx-auto selection:bg-black selection:text-white">
  <a href="#main-content" class="skip-link font-mono-swiss">Skip to content</a>

  <!-- ========================================================================= -->
  <!-- HEADER: STRICT SWISS MASTHEAD -->
  <!-- ========================================================================= -->
  <header class="site-header flex flex-col md:flex-row md:items-baseline justify-between pb-8 border-b-2 border-black gap-4">
    <div>
      <a href="/" class="group">
        <p class="text-xl md:text-2xl font-black tracking-tight uppercase group-hover:underline">
          Persio's Technical Journal & System Lab
        </p>
      </a>
      <div class="font-mono-swiss text-xs tracking-tight text-neutral-600 mt-0.5">
        persio.fyi &middot; Software, systems &amp; things learned
      </div>
    </div>

    <!-- Navigation with single purposeful Klein Blue focal indicator -->
    <nav aria-label="Main navigation" class="flex flex-wrap items-center gap-x-6 gap-y-3 font-mono-swiss text-xs font-bold uppercase tracking-wider shrink-0">
      <a href="/writing/" aria-current={Astro.url.pathname.startsWith('/writing') ? 'page' : undefined} class="hover:underline">Journal</a>
      <a href="/lab/" aria-current={Astro.url.pathname.startsWith('/lab') ? 'page' : undefined} class="hover:underline">Work</a>
      <a href="/cv/" aria-current={Astro.url.pathname.startsWith('/cv') ? 'page' : undefined} class="hover:underline">Timeline / CV</a>
      <!-- The sole purposeful accent: active state indicator -->
      <span class="klein-dot" aria-hidden="true"></span>
    </nav>
  </header>

  <!-- ========================================================================= -->
  <!-- MAIN CONTENT SLOT -->
  <!-- ========================================================================= -->
  <main id="main-content" class="pt-10 space-y-16">
    <slot />
  </main>

  <!-- ========================================================================= -->
  <!-- FOOTER: MINIMAL SWISS COLOPHON -->
  <!-- ========================================================================= -->
  <footer class="site-footer pt-8 border-t-2 border-black flex flex-col sm:flex-row justify-between items-baseline gap-4 font-mono-swiss text-[11px] text-neutral-600 mt-16">
    <div>
      <span class="text-black font-bold uppercase">Persio</span> &middot; Technical Journal & System Lab
    </div>
    <div class="flex flex-wrap items-center gap-6">
      <a href="/rss.xml" class="hover:text-black uppercase">RSS</a>
      {social.filter((s) => s.url).map((s) => (
        <a href={s.url} class="hover:text-black uppercase" target="_blank" rel="me noopener">{s.label}</a>
      ))}
      <a href="#top" class="hover:text-black uppercase">Top ↑</a>
    </div>
  </footer>

</body>
</html>
