---
import SwissLayout from '../../layouts/SwissLayout.astro';
import WritingFeed from '../../components/WritingFeed.astro';
import { getPublishedWriting } from '../../lib/published-writing';
const posts = await getPublishedWriting();
---

<SwissLayout title="Journal — persio.fyi" description="Short notes and occasional essays from Persio’s work on software, agents, infrastructure, and projects.">
  <div class="max-w-3xl space-y-10">
    <header class="space-y-5">
      <div class="flex flex-wrap gap-3 items-baseline justify-between border-b-2 border-black pb-3">
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">01 // Journal</h1>
        <a href="/rss.xml" class="font-mono-swiss text-xs font-bold uppercase underline underline-offset-4">RSS ↗</a>
      </div>
      <p class="text-base leading-relaxed text-neutral-800 max-w-2xl">Notes from the work: a decision, something I learned, a technique I’m using. Usually short. Sometimes an idea needs more room.</p>
    </header>
    {posts.length ? <WritingFeed posts={posts} /> : <p class="text-sm leading-relaxed">No entries yet. The first note will appear here when it is ready.</p>}
  </div>
</SwissLayout>
