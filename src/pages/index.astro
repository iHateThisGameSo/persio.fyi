---
import SwissLayout from '../layouts/SwissLayout.astro';
import AgentTopologyCanvas from '../components/AgentTopologyCanvas.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<SwissLayout title="Persio's Technical Journal & System Lab — persio.fyi">

  <!-- ========================================================================= -->
  <!-- 00 // MANIFESTO -->
  <!-- ========================================================================= -->
  <section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-baseline">
    <div class="md:col-span-3 font-mono-swiss text-xs text-neutral-500 uppercase tracking-widest">
      00 // MANIFESTO
    </div>
    <div class="md:col-span-9 space-y-3">
      <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-none uppercase">
        Distributed systems architecture, autonomous agent topologies, and uncompromised code.
      </h2>
      <p class="text-sm md:text-base text-neutral-700 max-w-3xl leading-relaxed">
        A personal space for publishing executable computational experiments, in-depth technical essays, and a rigorous record of software engineering impact.
      </p>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- TWO-COLUMN BROADSHEET ROW (01 LAB & 02 WRITING) -->
  <!-- ========================================================================= -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start pt-6">
    
    <!-- 01 // LAB -->
    <section id="lab" class="lg:col-span-6 space-y-8">
      <div>
        <div class="flex items-baseline justify-between mb-2">
          <h2 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">
            01 // LAB
          </h2>
          <a href="/lab" class="font-mono-swiss text-xs font-bold uppercase hover:underline">
            Open Full Lab →
          </a>
        </div>
        <div class="rule-heavy mb-4"></div>
        <p class="text-xs leading-relaxed text-neutral-700">
          Matrix simulations, realtime graphics, and autonomous agent orchestration experiments. Executed on WebAssembly and high-throughput Canvas 2D.
        </p>
      </div>

      <!-- Featured Lab Simulation -->
      <div class="space-y-3">
        <div class="flex items-baseline justify-between">
          <h3 class="text-base font-black uppercase tracking-tight">
            Realtime Agent Topology & Latency Matrix
          </h3>
          <span class="font-mono-swiss text-xs font-semibold text-neutral-500">
            01.01 | WASM, CANVAS
          </span>
        </div>
        <p class="text-xs leading-relaxed text-neutral-700">
          Interactive matrix simulation of minimal context delegation between worker nodes and a centralized coordinator.
        </p>

        <!-- Interactive Canvas Component -->
        <AgentTopologyCanvas heightClass="h-64" />
      </div>

      <!-- Upcoming Lab Experiment -->
      <div class="space-y-1.5 pt-4 border-t border-black/20">
        <div class="flex items-baseline justify-between">
          <h3 class="text-base font-black uppercase tracking-tight">
            eBPF Kernel Tracing for Zero-Overhead Syscall Auditing
          </h3>
          <span class="font-mono-swiss text-xs font-semibold text-neutral-500">
            01.02 | C, LINUX
          </span>
        </div>
        <p class="text-xs leading-relaxed text-neutral-600">
          In-kernel instrumentation of network sockets and filesystem dispatch without execution pauses.
        </p>
      </div>
    </section>

    <!-- 02 // WRITING -->
    <section id="writing" class="lg:col-span-6 space-y-8">
      <div>
        <div class="flex items-baseline justify-between mb-2">
          <h2 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">
            02 // WRITING
          </h2>
          <a href="/writing" class="font-mono-swiss text-xs font-bold uppercase hover:underline">
            All Essays ({sortedPosts.length}) →
          </a>
        </div>
        <div class="rule-heavy mb-4"></div>
      </div>

      <div class="space-y-6">
        {sortedPosts.map((post) => (
          <article class="space-y-2 pb-6 border-b border-black">
            <a href={`/writing/${post.slug}`} class="block group">
              <h3 class="text-lg md:text-xl font-black uppercase tracking-tight group-hover:underline">
                {post.data.title}
              </h3>
            </a>
            <div class="font-mono-swiss text-xs text-neutral-600 uppercase">
              {post.data.date} &middot; {post.data.category} &middot; {post.data.readingTime}
            </div>
            <p class="text-xs md:text-sm leading-relaxed text-neutral-800">
              {post.data.description}
            </p>
            <div class="pt-1">
              <a href={`/writing/${post.slug}`} class="font-mono-swiss text-xs font-bold uppercase underline">
                Read Complete Essay →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>

  <!-- ========================================================================= -->
  <!-- 03 // ARCHIVE & RECORD (CV) -->
  <!-- ========================================================================= -->
  <section id="cv" class="pt-8 space-y-6">
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">
        03 // ARCHIVE & RECORD
      </h2>
      <a href="/cv" class="font-mono-swiss text-xs font-bold uppercase hover:underline">
        Detailed CV →
      </a>
    </div>
    <div class="rule-heavy mb-6"></div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 text-xs font-mono-swiss">
      <!-- Item 1 -->
      <div class="md:col-span-3 font-bold text-neutral-600 uppercase">
        2024 — PRESENT
      </div>
      <div class="md:col-span-6 space-y-1">
        <div class="text-sm font-sans font-black uppercase">Engineering Leadership & AI Architecture</div>
        <p class="font-sans text-neutral-800 text-xs leading-relaxed">
          Designing and deploying enterprise multi-agent platforms, deterministic tool governance, and model routing infrastructures.
        </p>
      </div>
      <div class="md:col-span-3 text-neutral-600 uppercase md:text-right">
        Staff Architect
      </div>

      <div class="md:col-span-12 border-b border-black/15 my-1"></div>

      <!-- Item 2 -->
      <div class="md:col-span-3 font-bold text-neutral-600 uppercase">
        2020 — 2024
      </div>
      <div class="md:col-span-6 space-y-1">
        <div class="text-sm font-sans font-black uppercase">Principal Software Engineer & Strategic Advisory</div>
        <p class="font-sans text-neutral-800 text-xs leading-relaxed">
          Architecture of distributed high-throughput backends, mission-critical legacy modernizations, and cloud cost engineering.
        </p>
      </div>
      <div class="md:col-span-3 text-neutral-600 uppercase md:text-right">
        Advisory
      </div>

      <div class="md:col-span-12 border-b border-black/15 my-1"></div>

      <!-- Competencies -->
      <div class="md:col-span-3 font-bold text-neutral-600 uppercase">
        CORE DOMAINS
      </div>
      <div class="md:col-span-9 font-sans text-xs text-neutral-800 leading-relaxed">
        <strong class="uppercase font-black text-black">Languages & Runtimes:</strong> Rust, TypeScript, Python, Go, C, Node.js, WebAssembly.<br>
        <strong class="uppercase font-black text-black">Architecture:</strong> Autonomous AI Topologies, Minimal Context Pipelines, High-Scale Concurrency, Linux Kernel Systems (eBPF), Security & Local Secret Governance.
      </div>
    </div>
  </section>

</SwissLayout>
