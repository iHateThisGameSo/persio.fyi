---
import SwissLayout from '../layouts/SwissLayout.astro';
import WritingFeed from '../components/WritingFeed.astro';
import { getPublishedWriting } from '../lib/published-writing';
const posts = await getPublishedWriting();
---

<SwissLayout>
  <section class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start">
    <div class="md:col-span-3 font-mono-swiss text-xs text-neutral-600 uppercase tracking-widest">00 // Persio</div>
    <div class="md:col-span-9 space-y-6">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tighter leading-none uppercase">Building.<br />Testing.<br />Writing.</h1>
      <p class="text-base md:text-lg max-w-2xl leading-relaxed text-neutral-800">I work on software, AI-assisted workflows, and project risk management. This is a journal of what I’m working on and learning along the way.</p>
      <p class="font-mono-swiss text-xs text-neutral-600">Short notes, occasional longer pieces. Published when there is something to say.</p>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <section class="lg:col-span-8 space-y-7" aria-labelledby="journal-title">
      <div class="flex flex-wrap gap-3 justify-between items-baseline border-b-2 border-black pb-3">
        <h2 id="journal-title" class="text-3xl md:text-4xl font-black tracking-tighter uppercase">01 // Journal</h2>
        <a href="/writing/" class="font-mono-swiss text-xs uppercase font-bold hover:underline">All entries →</a>
      </div>
      {posts.length ? <WritingFeed posts={posts.slice(0, 3)} /> : <p class="text-sm leading-relaxed">The journal is open. The first note will appear here when it is ready.</p>}
    </section>
    <aside class="lg:col-span-4 space-y-10">
      <section class="space-y-4">
        <h2 class="text-2xl font-black tracking-tight uppercase border-b-2 border-black pb-3">02 // Work</h2>
        <p class="text-sm leading-relaxed text-neutral-800">Agent workflows, websites, automation, and the infrastructure that supports them. Alongside that: consulting on project risk and control.</p>
        <a href="/lab/" class="inline-block font-mono-swiss text-xs uppercase font-bold underline underline-offset-4">What I work on →</a>
      </section>
      <section class="space-y-4">
        <h2 class="text-2xl font-black tracking-tight uppercase border-b-2 border-black pb-3">03 // Trajectory</h2>
        <p class="font-mono-swiss text-xs text-neutral-600 uppercase">1995 onward</p>
        <p class="text-sm leading-relaxed text-neutral-800">An English exchange, Mandic’s internet era, networks and operations, technical leadership, and independent work.</p>
        <a href="/cv/" class="inline-block font-mono-swiss text-xs uppercase font-bold underline underline-offset-4">The timeline / CV →</a>
      </section>
    </aside>
  </div>
</SwissLayout>
