---
import SwissLayout from '../layouts/SwissLayout.astro';
---

<SwissLayout title="Page not found — persio.fyi" description="This page is unavailable. Return to Persio’s journal or homepage.">
  <section class="max-w-3xl space-y-6">
    <p class="font-mono-swiss text-xs uppercase text-neutral-600">404 // Page not found</p>
    <h1 class="text-4xl md:text-6xl font-black tracking-tighter uppercase leading-none">This page isn’t here.</h1>
    <p class="text-base leading-relaxed text-neutral-800">The address may have changed, or the entry may have been removed.</p>
    <div class="flex flex-wrap gap-6 font-mono-swiss text-xs uppercase font-bold">
      <a href="/writing/" class="underline underline-offset-4">Go to the journal →</a>
      <a href="/" class="underline underline-offset-4">Home →</a>
    </div>
  </section>
</SwissLayout>
