---
import SwissLayout from '../../layouts/SwissLayout.astro';
---

<SwissLayout title="Lab — persio.fyi" description="Experiments will be published here once they can be reproduced.">
  <div class="space-y-8">
    <div>
      <div class="flex items-baseline justify-between mb-2">
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase">
          01 // LAB
        </h1>
        <span class="font-mono-swiss text-xs text-neutral-500 uppercase">
          [ 0 EXPERIMENTS ]
        </span>
      </div>
      <div class="rule-heavy mb-6"></div>
      <p class="text-sm max-w-2xl text-neutral-700 leading-relaxed">
        Empty for now. Nothing goes here until it runs, is measured and can be reproduced by someone else.
      </p>
    </div>
  </div>
</SwissLayout>
