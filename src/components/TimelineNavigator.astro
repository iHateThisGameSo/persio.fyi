---
const eras = [
  { target: 'exchange', year: '1995', label: 'Beginnings' },
  { target: 'mandic', year: '1998', label: 'Internet' },
  { target: 'uol', year: '2002', label: 'Projects' },
  { target: 'verizon-operations', year: '2006', label: 'Operations' },
  { target: 'cisco-engineer', year: '2013', label: 'Engineering' },
  { target: 'independent', year: '2026', label: 'Independent' },
];
---

<nav id="timeline-navigator" class="era-navigator print-control" aria-label="Timeline eras">
  <div class="era-caption font-mono-swiss">
    <span>Explore the timeline</span>
    <span id="current-era">1995 / Beginnings</span>
  </div>
  <div class="era-links">
    {eras.map((era, index) => (
      <a href={`#${era.target}`} data-era-label={`${era.year} / ${era.label}`} aria-label={`${era.year}: ${era.label}`} aria-current={index === 0 ? 'location' : undefined}>
        <span class="era-year">{era.year}</span>
        <span class="era-name">{era.label}</span>
      </a>
    ))}
  </div>
  <div class="era-track" aria-hidden="true"><span id="timeline-progress"></span></div>
</nav>

<script>
  const navigator = document.getElementById('timeline-navigator');
  const timeline = document.getElementById('timeline');
  const progress = document.getElementById('timeline-progress');
  const label = document.getElementById('current-era');

  if (navigator && timeline && progress && label) {
    const links = [...navigator.querySelectorAll<HTMLAnchorElement>('a')];
    const eras = links.map(link => ({ link, target: document.querySelector<HTMLElement>(link.hash) })).filter(era => era.target);
    const first = timeline.querySelector<HTMLElement>('.timeline-entry');
    const last = timeline.querySelector<HTMLElement>('.timeline-entry:last-child');
    let frame = 0;
    let current: HTMLAnchorElement | undefined;

    const update = () => {
      frame = 0;
      if (!first || !last) return;
      const offset = navigator.offsetHeight + 24;
      const position = window.scrollY + offset;
      const start = first.getBoundingClientRect().top + window.scrollY;
      const end = last.getBoundingClientRect().top + window.scrollY;
      const fraction = Math.min(1, Math.max(0, (position - start) / Math.max(1, end - start)));
      progress.style.transform = `scaleX(${fraction})`;
      timeline.style.setProperty('--era-offset', `${offset}px`);

      let selected = eras[0];
      for (const era of eras) {
        if (era.target!.getBoundingClientRect().top + window.scrollY <= position + 2) selected = era;
      }
      if (selected && selected.link !== current) {
        for (const { link } of eras) link.removeAttribute('aria-current');
        selected.link.setAttribute('aria-current', 'location');
        label.textContent = selected.link.dataset.eraLabel ?? '';
        current = selected.link;
      }
    };

    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('load', schedule, { once: true });
    document.fonts.ready.then(schedule);
    update();

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in-view');
            observer.unobserve(entry.target);
          }
        }
      }, { threshold: 0.15 });
      timeline.querySelectorAll('.timeline-entry').forEach(entry => observer.observe(entry));
    }
  }
</script>
